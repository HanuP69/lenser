# LectureLens Configuration
# How the models are chosen. "hybrid" is the default: the cloud providers
# of the chain are asked first and the local Ollama model is the fallback
# that is only asked when every cloud provider was refused. "local" asks
# the local model alone, and "cloud" leaves the local model out entirely.
LECTURELENS_LLM_MODE=hybrid
LECTURELENS_REDIS_URL=redis://localhost:6379
LECTURELENS_POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/lecturelens
LECTURELENS_OLLAMA_URL=http://localhost:11434
LECTURELENS_LOCAL_MODEL=gemma3:4b
LECTURELENS_EMBEDDING_MODEL=nomic-embed-text

# Gateway Server
LECTURELENS_GATEWAY_HOST=127.0.0.1
LECTURELENS_GATEWAY_PORT=8765
LECTURELENS_GATEWAY_API_KEY=

# Storage and Directories
LECTURELENS_OUTPUT_DIR=./output
LECTURELENS_ROUTER_CONFIG_PATH=./router.yaml

# Audio and Transcription
LECTURELENS_AUDIO_SOURCE=mic
LECTURELENS_WHISPER_MODEL_SIZE=base
LECTURELENS_WHISPER_DEVICE=cpu
LECTURELENS_WHISPER_COMPUTE_TYPE=

# Screen Capture & Vision
LECTURELENS_SCREENSHOT_INTERVAL_SECONDS=1.0
LECTURELENS_SLIDE_DIFF_THRESHOLD=0.004
LECTURELENS_MONITOR_INDEX=1

# What is recorded. "window" records a single window on the desktop, which
# is the better choice, because the rest of the desktop belongs to other
# work and a video call on the same display would put the faces of the
# participants into the notes. "screen" records the whole display.
#
# Run "lecturelens windows" to see the windows that can be recorded, and
# "lecturelens windows --set 3" to remember one of them. The choice is
# asked for on the first run.
LECTURELENS_CAPTURE_TARGET=screen
LECTURELENS_WINDOW_HANDLE=
LECTURELENS_WINDOW_TITLE=

# Context Drift & Ad Filter
LECTURELENS_ENABLE_DRIFT_FILTER=true
LECTURELENS_DRIFT_THRESHOLD=0.50

# Structuring
# A second pass writes the mathematics of a section in LaTeX, because the
# model does not always do it when it is asked to. Switch it off to save
# one request per section.
LECTURELENS_STRUCTURING_LATEX_PASS=true

# Cloud Providers & Multi-Key Rotation (comma-separated supported)
UNOROUTER_API_KEY=
UNOROUTER_API_KEYS=
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
GOOGLE_API_KEY=
GOOGLE_API_KEYS=
GEMINI_API_KEY=
GEMINI_API_KEYS=
